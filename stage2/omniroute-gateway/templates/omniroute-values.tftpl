# Helm values for the omniroute chart. Overrides ONLY what the module must own; every other key
# keeps its chart 0.2.2 default. Each key below was confirmed against a `helm template` render of
# chart 0.2.2. Rendered by templatefile() from omniroute.tf.

# Pins the Service/Deployment name so the Ingress backends and the module outputs reference a single
# local instead of inheriting whatever the Helm release happens to be called.
fullnameOverride: omniroute

image:
  repository: diegosouzapw/omniroute
  # Empty defaults to the chart appVersion. For web-cookie providers (gemini-web, claude-web,
  # claude-turnstile) use the "-web" flavor, e.g. "3.8.50-web". Quoted so an empty tag stays a
  # string rather than YAML null.
  tag: "${image_tag}"

# All 4 auth keys live in a module-owned Secret (secrets.tf). A non-empty existingSecret keeps every
# credential out of the Helm values string and makes the chart skip its own secret.yaml, which would
# otherwise mint fresh JWT_SECRET / API_KEY_SECRET on every client-side render.
auth:
  existingSecret: ${auth_secret_name}

# The open API edge Ingress (/v1 and /api/v1) is unauthenticated, so require an API key on proxy
# calls. extraConfig
# merges over config, so this wins over the chart default REQUIRE_API_KEY "false".
#
# STORAGE_ENCRYPTION_KEY_VERSION is the version label OmniRoute pairs with STORAGE_ENCRYPTION_KEY.
# It defaults to unset, which forces the app's first-boot bootstrap to persist the marker to
# {DATA_DIR}/server.env. Supplying it here keeps config fully external (the PVC then holds only the
# SQLite DB) and suppresses the misleading "zero-config mode" dashboard banner, which fires whenever
# bootstrap persists anything, not only when it auto-generates keys. Bump to "v2" only if
# omniroute_storage_encryption_key is ever rotated.
#
# OMNIROUTE_MEMORY_MB is the V8 old-space ceiling dev/run-standalone.mjs appends to NODE_OPTIONS.
# The chart default 384 aborts this gateway with "Reached heap limit", and the abort reaches
# Kubernetes as exit 0 / reason Completed, so no reason-based alert catches it. At least 215 MiB of
# runtime, native SQLite and off-heap stream buffers lives outside the cap and grows with concurrent
# streams, so limits.memory below must clear the cap by several hundred MiB.
#
# OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK stops the background credential-health probes. They
# bill a real upstream call per provider and burn free-tier quota to learn what a failing live
# request already reports. The flag is read once at startup, so changing it must roll the pod.
extraConfig:
  REQUIRE_API_KEY: "true"
  STORAGE_ENCRYPTION_KEY_VERSION: "v1"
  OMNIROUTE_MEMORY_MB: "1024"
  CREDENTIAL_REDACTION_ENABLED: "true"
  OMNIROUTE_DISABLE_CREDENTIAL_HEALTH_CHECK: "true"

# Kept in lockstep with the heap cap above: raise both or neither. memory request == limit stops
# usage ever exceeding the request, which is what puts the pod in the kubelet's last-evicted tier
# under node memory pressure. QoS stays Burstable because the CPU pair differs, deliberately: a
# full-core reservation is not justified by measured usage, and 250m is only there to restore
# scheduling weight for mark-compact, which the chart's 50m leaves at near-minimum.
resources:
  requests:
    cpu: 250m
    memory: 1536Mi
  limits:
    cpu: "1"
    memory: 1536Mi

# SQLite is a single-writer store on this PVC. The chart hard-pins a single replica and a Recreate
# update mode for that reason, and the module deliberately leaves both at the chart default: two
# pods sharing one PVC would corrupt the database. Do not add a replica or update-mode override here.
persistence:
  enabled: true
  size: ${storage_size}
  storageClass: ${storage_class}

# Ingress is module-owned (ingress.tf): the dashboard sits behind oauth2-proxy while the API prefixes
# (/v1 and /api/v1) stay open to key-authenticated clients. Disable the chart's own single Ingress.
ingress:
  enabled: false
