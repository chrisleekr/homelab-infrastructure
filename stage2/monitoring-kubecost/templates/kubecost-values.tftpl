# https://github.com/kubecost/kubecost/blob/develop/kubecost/values.yaml
#
# Overrides only; everything else takes the chart default. Kubecost 3.x dropped Prometheus and
# Grafana entirely: metrics come from the bundled localStore, and finops-agent pushes ETL to the
# MinIO federated store, which the aggregator reads back.
global:
  # Stamped onto every ETL file the agent writes. The aggregator matches on it to attribute data
  # back to this cluster, so changing it orphans everything already in the federated store.
  clusterId: "${cluster_id}"
  federatedStorage:
    existingSecret: "${federated_store_secret_name}"
  # Covers the aggregator, localStore and finopsagent claims unless one overrides it. Pinned rather
  # than left to the cluster default so the claims do not move if that default ever changes.
  defaultStorageClass: "${storage_class_name}"

# Basic Kubecost ingress, more examples available at https://docs.kubecost.com/install-and-configure/install/ingress-examples
ingress:
  enabled: true
  className: ${ingress_class_name}
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    nginx.ingress.kubernetes.io/auth-url: "https://${auth_oauth2_proxy_host}/oauth2/auth"
    nginx.ingress.kubernetes.io/auth-signin: "https://${auth_oauth2_proxy_host}/oauth2/start?rd=$scheme://$host$escaped_request_uri"
    nginx.ingress.kubernetes.io/auth-response-headers: "X-Auth-Request-User,X-Auth-Request-Email,X-Auth-Request-Access-Token"
  paths: ["/"]  # There's no need to route specifically to the pods-- we have an nginx deployed that handles routing
  pathType: ImplementationSpecific
  hosts:
    - ${kubecost_ingress_host}
  %{ if ingress_enable_tls }
  tls:
    - secretName: kubecost-tls
      hosts:
      - ${kubecost_ingress_host}
  %{ endif }

# Chart default is enabled. The hostNetwork DaemonSet only refines egress attribution, which is
# meaningless on a single-node homelab.
networkCosts:
  enabled: false

# Chart default is enabled, which binds a ClusterRole granting cluster-wide `namespaces: delete`
# and patch on every workload kind. Only the Actions feature consumes it, and that stays off.
clusterController:
  enabled: false

aggregator:
  aggregatorDbStorage:
    # Chart default 128Gi is sized for multi-cluster enterprise federation.
    storageRequest: 32Gi
  # Keep a rolling quarter of daily history to limit ClickHouse part count.
  retention1d: 90
  resources:
    # Chart leaves limits empty, so ETL bursts are unbounded. Capping costs ETL wall-clock on the
    # tail, not readiness. The chart's 100m/3Gi requests are left alone. Raise if ingestion lags.
    limits:
      cpu: 1000m

# finops-agent subchart requests 500m/512Mi, sized for a multi-node cluster. Only the requests are
# lowered; its 2Gi memory limit stays as the backstop.
finopsagent:
  enabled: true
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
  persistence:
    enabled: true
    size: 8Gi

forecasting:
  resources:
    requests:
      # Chart default 200m books more than this cluster's forecasting workload draws. Memory
      # request and both limits (1500m/1Gi) stay at chart defaults.
      cpu: 50m
